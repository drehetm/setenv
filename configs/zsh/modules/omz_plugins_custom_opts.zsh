# This file contains overrides of the default Oh My Zsh plugins options

# Settings for the vi-mode plugin:
# -> Changes the cursor on each mode change automatically
VI_MODE_SET_CURSOR=true
# -> Makes terminal's behavior consistent with my current Neovim configuration
# It changes visual cursor to `solid block`, which must be equal to `VI_MODE_CURSOR_NORMAL` value
# Below option described [here](https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/vi-mode#cursor-styles)
VI_MODE_CURSOR_VISUAL=2

